TYPE "i550Motec_customControl"
TITLE = {"version":"v1.0","author":"cyanezf","family":"core/controller/lenze/i550-motec","status":"current","deprecatedBy": null,"dependencies":["i550Motec_netWordIN1Control-v1.0"]}

//(*--
