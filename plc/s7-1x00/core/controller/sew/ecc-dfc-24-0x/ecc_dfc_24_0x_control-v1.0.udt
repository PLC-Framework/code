   STRUCT
      position : LReal;   // Position
      tolerance : LReal;   // Tolerance
      velocity : LReal;   // Velocity
      acceleration : LReal;   // Acceleration
      deceleration : LReal;   // Deceleration
      servoCommand : Word;   // 0=Null; 1=Homing; 2=Absolute positioning
      run : Bool;   // 1=Run control
      direction : Bool;   // 0=Run forward; 1=Run backward
   END_STRUCT;

END_TYPE

