   STRUCT
      position : LReal;   // Position
      tolerance : LReal;   // In position tolerance
      velocity : LReal;   // User speed in ECR=[mm/s]; ECG=[rpm]x10
      acceleration : LReal;   // Acceleration ECR=mm; ECG=inc/rev
      deceleration : LReal;   // Deceleration ECR=mm; ECG=inc/rev
   END_STRUCT;

END_TYPE

