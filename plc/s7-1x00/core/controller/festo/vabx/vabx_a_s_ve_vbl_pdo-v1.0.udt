TYPE "vabx_a_s_ve_vbl_pdo"
TITLE = {"version":"v1.0","author":"cyanezf","family":"core/controller/festo/vabx","status":"current","deprecatedBy": null,"dependencies":[]}

//(*--
//# Documentation
//## Log
//| version | date | author | description |
//|:-------:|:----:|:------:|:------------|
//| v1.0 | 2026-07-01 | cyanezf | First version |
//
//## Description
//This data type is used to set data to VABX-A-S-VE-VBL.
//
//--*)

   STRUCT
      vacuumGeneration : Bool;   // 0.0: Vacuum generation; 0=OFF; 1=ON
      ejectorPulse : Bool;   // 0.1: Ejector pulse; 0=OFF; 1=ON; Prerequisites: automatic ejector pulse is activated (param. 20243) and vacuum generation is switched off (PDI, 0.0 siwtches from 1 to 0)
      x2 : Bool;   // 0.2
      x3 : Bool;   // 0.3
      x4 : Bool;   // 0.4
      x5 : Bool;   // 0.5
      x6 : Bool;   // 0.6
      saveData : Bool;   // 0.7: Trigger data save; 0=Default after reset or restart; 1=Save process
      startTeachIn : Bool;   // 1.0: Start teach-in
      selectChannel : Bool;   // 1.1: Select channel; 0=Channel 1; 1=Not used
      teachInMode0 : Bool;   // 1.2: Teach-in mode; 0=Static; 1=Dynamic
      teachInmode1 : Bool;   // 1.3: Teach-in mode; 0=Default valued for continunus suction without air saving function; 1=Optimised values for the air saving function
      selectOutput : Bool;   // 1.4: Select output; 0=Out_A; 1=Out_B
      teachInForTP1 : Bool;   // 1.5: Teach-in for TP1
      teachinForTP2 : Bool;   // 1.6: Teach-in for TP2
      saveTeachIn : Bool;   // 1.7: Save teach-in (stop)
   END_STRUCT;

END_TYPE

