TYPE "jxd1_driveUnit_16bytes_directNumericalSettingModePdi"
TITLE = {"version":"v1.0","author":"cyanezf","family":"core/controller/smc/jxd1","status":"current","deprecatedBy": null,"dependencies":[]}

//(*--
//# Documentation
//## Log
//| version | date | author | description |
//|:-------:|:----:|:------:|:------------|
//| v1.0 | 2026-07-19 | cyanezf | First version |
// 
//## Description
//This is the Process Data Input (PDI) structure for the SMC JXD1 series actuators when used with the S7-1x00 PLCs.
//It contains status words and data fields that are used to receive information from the axis as direct numerical settings mode.
//--*)

   STRUCT
      position : DInt;   // 0.0: Current position in 0.01 mm
      force : Int;   // 4.0: Current force in %
      w6 : Word;   // 6.0
      velocity : Int;   // 8.0: Current velocity in mm/s
      w10 : Word;   // 10.0
      alarmCode : Word;   // 12.0: Latest alarm that has occurred at the drive unit is output as an alarm code 0x0000 to 0xFFFF, see 9.7.1. Handling of individual data
      status : Struct   // 14.0: Status word
         x0 : Bool;   // 14.0
         x1 : Bool;   // 14.1
         x2 : Bool;   // 14.2
         x3 : Bool;   // 14.3
         inWarea : Bool;   // 14.4: WAREA - OFf=Out of range; ON=W area output end 1 <= current position <= W are output end 2.
         x5 : Bool;   // 14.5
         ready : Bool;   // 14.6: RDY - ON=Servo is On and there is no alarm. Servo is ready for operation
         eStop : Bool;   // 14.7: ESTOP - OFF=Normal; Turns On when the axis is set to disabled in ACT-Connected or the stop is caused by a specific reason. ON=EMG stop at the power input termina. Stopped due to low motor power supply voltage. Stopped due to low control power supply voltage
         inPosition : Bool;   // 15.0: INP - Turns on when the current position is within the target position width. In-position operation: target position +- positioining width. Pushing operation: Current force is > pushing force. Home positioning: Home position +- parameter "initial positioning width". Turns OFF when the target position is out of range or when the target position width is changed by the next operation command
         isHomed : Bool;   // 15.1: SETON - Indicates the homing is complete and the position is fixed. ON=Position is fixed; OFF=Position is not fixed
         isRunning : Bool;   // 15.2: BUSY - Motor is rotating or running. However the following statuses are Stopped. * During temporary stop by HOLD input (running during homing). * During pushing operation and INP output (When INP is OFF, the servo is "in operation"). * When the motor stops when the servo is on, other than the above.
         error : Bool;   // 15.3: ALM - OFF when all alarms are cleared; ON=Some alarm
         servoReady : Bool;   // 15.4: SVRE - ON=Servo is on
         pmis : Bool;   // 15.5: PMIS - Turns ON when a swing occurs during pushing operation. PMIS is switched off at the following times. -At the start of the next operation command execution. 
         xE : Bool;   // 15.6
         warning : Bool;   // 15.7: WARN - OFF=Normal; ON=Alarm (warning) detection without stop
      END_STRUCT;
   END_STRUCT;

END_TYPE

