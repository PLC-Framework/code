FUNCTION_BLOCK "_bwu4893io14_singleRoller"
TITLE = {"version":"v1.0","author":"cyanezf","family":"core/controller/bihl-wiedermann/bwu4893","status":"current","deprecatedBy":null,"dependencies":["bwu4893io14pdi-v1.0","bwu4893io14pdO-v1.0"]}
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : cyanezf
FAMILY : 'core/controller/bihl-wiedermann/bwu4893'
NAME : _bwu4893io14_singleRoller
VERSION : 1.0
   VAR_INPUT 
      motorNr { ExternalWritable := 'False'} : USInt := 1;   // IR: 2=Motor 2, 3=Motor 3; 4=Motor 4, N=Motor 1
      controlOn { ExternalWritable := 'False'} : Bool;   // IR: 1=Control on
      emrgStopOk { ExternalWritable := 'False'} : Bool;   // IR: 1=Emergency ok
      runForward { ExternalWritable := 'False'} : Bool;   // IR: 1=Run forward
      runBackward { ExternalWritable := 'False'} : Bool;   // IR: 1=Run backward
      ccw { ExternalWritable := 'False'} : Bool;   // IR: 0=Clock wise - 1=Counter clock wise
      speed { ExternalWritable := 'False'} : Real;   // IR: Setpoint speed +-%
      rampUp { ExternalWritable := 'False'} : Time := T#100ms;   // IR: Setpoint ramp up from 0 to 25.5s
      rampDown { ExternalWritable := 'False'} : Time := T#100ms;   // IR: Setpoint ramp down from 0 to 25.5s
      config { ExternalWritable := 'False'} : Struct   // IR: Configuration
         maxCurrent { ExternalWritable := 'False'} : UInt;   // IR: Min. current to know if motor is running
         maxSpeed { ExternalWritable := 'False'} : Real := 100.0;   // IR: Max real speed
      END_STRUCT;
   END_VAR

   VAR_OUTPUT 
      ready { ExternalWritable := 'False'} : Bool;   // OR: 1=Ready
      status { ExternalWritable := 'False'} : Int;   // OR: 0=Ok, 0x8???=Error
      isRunning { ExternalWritable := 'False'} : Bool;   // OR: 1=Is running
      direction { ExternalWritable := 'False'} : Bool;   // OR: 0=Forward; 1=Backward
      actualCurrent { ExternalWritable := 'False'} : Real;   // OR: Actual current in Ampers
      actualSpeed { ExternalWritable := 'False'} : Real;   // OR: Actual speed in speed in U
   END_VAR

   VAR_IN_OUT 
      pdi : "bwu4893io14pdi";   // IOX: Read only - PDI
      pdo : "bwu4893io14pdo";   // IOX: Write - PDO
   END_VAR

   VAR 
      private { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Struct   // SX: Private static variables
         run { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
         ramp { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Time;
      END_STRUCT;
   END_VAR

   VAR_TEMP 
      ok : Bool;
      motor : Struct
         run : Bool;
         direction : Bool;
         fuseTriggered : Bool;
         error : Bool;
         speed : SInt;
         current : UInt;
         ramp : USInt;
      END_STRUCT;
   END_VAR

   VAR CONSTANT 
      MOTOR_2 : USInt := 2;
      MOTOR_3 : USInt := 3;
      MOTOR_4 : USInt := 4;
      NO_SPEED : SInt := 0;   // 0%
      MAX_SPEED : SInt := 100;   // 100%
      NO_RAMP : Time := T#0ms;
      MAX_RAMP : Time := T#25S500ms;
      RAMP_FACTOR : DInt := 100;
      CURRENT_FACTOR : Real := 1000.0;
      STATUS_0000_OK : Int := 0;
      STATUS_8000_ERROR : Int := 16#8000;
      STATUS_8001_FUSE : Int := 16#8001;
   END_VAR


BEGIN
	(*--
	# Documentation
	
	## Log
	
	| version | date | author | description |
	|:-------:|:----:|:------:|:------------|
	| v1.0 | 2026-10-29 | cyanezf | First version |
	
	## Description
	
	This function controls Bihl-Biedemann BWU4893 for single roller.
	
	--*)
	
	// Speed to %
	// MAX_SPEED -> 100%
	// #SP_speed  -> ?
	// ? = #SP_speed * 100% / MAX_SPEED
	IF #speed <= 0.0 THEN
	  #motor.speed := #NO_SPEED;
	ELSIF #speed >= #config.maxSpeed THEN
	  #motor.speed := #MAX_SPEED;
	ELSE
	  #motor.speed := REAL_TO_SINT(#speed * SINT_TO_REAL(#MAX_SPEED) / #config.maxSpeed);
	END_IF;
	
	// Ok
	#ok := #controlOn AND #emrgStopOk AND #ready AND #motor.speed > #NO_SPEED;
	#motor.run := (#runForward XOR #runBackward) AND #ok;
	
	// | runForward | runBackward | ccw || Direction | Description |
	// | :--------- | :---------- | :-- || :-------- | :---------- |
	// | 1          | 0           | 0   || 0         | Forward is clock wise |
	// | 1          | 0           | 1   || 1         | Forward is counter clock wise |
	// | 0          | 1           | 0   || 0         | Backward is counter clock wise |
	// | 0          | 1           | 1   || 1         | Backward is clock wise |
	#motor.direction := #motor.run AND ((#runBackward AND NOT #ccw) OR (#runForward AND #ccw)); // 0=cw; 1=ccw
	
	// Ramp
	IF #motor.run AND NOT #private.run THEN
	  
	  IF #rampDown < #NO_RAMP THEN
	    #private.ramp := #NO_RAMP;
	  ELSIF #rampDown > #MAX_RAMP THEN
	    #private.ramp := #MAX_RAMP;
	  ELSE
	    #private.ramp := #rampDown;
	  END_IF;
	  
	ELSIF NOT #motor.run AND #private.run THEN
	  
	  IF #rampUp < #NO_RAMP THEN
	    #private.ramp := #NO_RAMP;
	  ELSIF #rampUp > #MAX_RAMP THEN
	    #private.ramp := #MAX_RAMP;
	  ELSE
	    #private.ramp := #rampUp;
	  END_IF;
	  
	END_IF;
	
	#private.run := #motor.run;
	#motor.ramp := DINT_TO_USINT(#private.ramp / #RAMP_FACTOR);
	
	// Select output motor
	CASE #motorNr OF
	  #MOTOR_2:
	    // Control
	    IF #motor.run AND #motor.#direction THEN
	      #pdo.motor2_speed := - #motor.#speed;
	    ELSIF #motor.run AND NOT #motor.direction THEN
	      #pdo.motor2_speed := #motor.#speed;
	    ELSE
	      #pdo.motor2_speed := #NO_SPEED;
	    END_IF;
	    
	    #pdo.motor2_ramp := #motor.ramp;
	    
	    // Status
	    #motor.fuseTriggered := #pdi.motor2_fuseTriggered;
	    #motor.error := #pdi.motor2_error;
	    #motor.current := #pdi.motor2_current;
	    
	  #MOTOR_3:
	    
	    IF #motor.run AND #motor.#direction THEN
	      #pdo.motor3_speed := - #motor.#speed;
	    ELSIF #motor.run AND NOT #motor.direction THEN
	      #pdo.motor3_speed := #motor.#speed;
	    ELSE
	      #pdo.motor3_speed := #NO_SPEED;
	    END_IF;
	    
	    #pdo.motor3_ramp := #motor.ramp;
	    
	    // Status
	    #motor.fuseTriggered := #pdi.motor3_fuseTriggered;
	    #motor.error := #pdi.motor3_error;
	    #motor.current := #pdi.motor3_current;
	    
	  #MOTOR_4:
	    
	    IF #motor.run AND #motor.#direction THEN
	      #pdo.motor4_speed := - #motor.#speed;
	    ELSIF #motor.run AND NOT #motor.direction THEN
	      #pdo.motor4_speed := #motor.#speed;
	    ELSE
	      #pdo.motor4_speed := #NO_SPEED;
	    END_IF;
	    
	    #pdo.motor4_ramp := #motor.ramp;
	    
	    // Status
	    #motor.fuseTriggered := #pdi.motor4_fuseTriggered;
	    #motor.error := #pdi.motor4_error;
	    #motor.current := #pdi.motor4_current;
	    
	  ELSE  // Motor 1
	    IF #motor.run AND #motor.#direction THEN
	      #pdo.motor1_speed := - #motor.#speed;
	    ELSIF #motor.run AND NOT #motor.direction THEN
	      #pdo.motor1_speed := #motor.#speed;
	    ELSE
	      #pdo.motor1_speed := #NO_SPEED;
	    END_IF;
	    
	    #pdo.motor1_ramp := #motor.ramp;
	    
	    // Status
	    #motor.fuseTriggered := #pdi.motor1_fuseTriggered;
	    #motor.error := #pdi.motor1_error;
	    #motor.current := #pdi.motor1_current;
	    
	END_CASE;
	
	// Status and ready
	#status := #STATUS_0000_OK;
	
	IF #motor.error THEN
	  #status := #STATUS_8000_ERROR;
	ELSIF #motor.fuseTriggered THEN
	  #status := #STATUS_8001_FUSE;
	END_IF;
	
	#ready := #status = #STATUS_0000_OK;
	
	#isRunning := #motor.run;
	#direction := #motor.run AND #motor.direction;
	
	#actualCurrent := UINT_TO_REAL(#motor.current) / #CURRENT_FACTOR;
	#actualSpeed := #motor.speed;
	
	// Save RLO
	ENO := true;
	
END_FUNCTION_BLOCK

