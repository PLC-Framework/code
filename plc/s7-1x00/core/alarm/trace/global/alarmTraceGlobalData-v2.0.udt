TYPE "alarmTraceGlobalData"
TITLE = {"version":"v2.0","author":"cyanezf","family":"core/alarm/trace/global","status": "current", "deprecatedBy": null, "dependencies":["alarmTraceGlobalLevel-v2.0"]}

//(*--
//# Documentation
//## Log
//| version | date | author | description |
//|:-------:|:----:|:------:|:------------|
//| v2.0 | 2025-04-24 | cyanezf | triggered changed to UINT |
//| v1.0 | 2025-02-01 | cyanezf | First version |
//
//## Description
//Alarm trace global data
//--*)

  STRUCT
    level : USInt;   // 0=No alarm, 1=a1i Info, 2=a2w warning, 3=a3e error, 4=a4f emergency
    super : UInt;   // Super group ID
    group : UInt;   // Group ID
    object : UInt;   // Object ID
    id : Int;   // Alarm ID
    a1i { S7_SetPoint := 'False'} : "alarmTraceGlobalLevel";   // Alarm level 1 - Info
    a2w { S7_SetPoint := 'False'} : "alarmTraceGlobalLevel";   // Alarm level 2 - Warning
    a3e { S7_SetPoint := 'False'} : "alarmTraceGlobalLevel";   // Alarm level 3 - Error
    a4f { S7_SetPoint := 'False'} : "alarmTraceGlobalLevel";   // Alarm level 4 - Emergency
  END_STRUCT;

END_TYPE
