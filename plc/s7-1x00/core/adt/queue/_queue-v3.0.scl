FUNCTION "_queue" : Int
TITLE = {"status": "current", "deprecatedBy": null, "dependencies" : ["queueInstanceAttributes-v3.0", "MOVE_BLK_VARIANT"]}
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : cyanezf
FAMILY : 'core/adt/queue'
NAME : _queue
VERSION : 3.0
   VAR_INPUT 
      method : Int;   // Method to be executed. 1=Init; 10=Enqueue(Add); 11=Dequeue(Remove); 12=Peek
   END_VAR

   VAR_IN_OUT 
      instance : "queueInstanceAttributes";   // Queue instance
      data : Variant;   // Array of data of type <E>
      buffer : Variant;   // Data buffer of type <E>
   END_VAR

   VAR_TEMP 
      retVal : Int;
      length : DInt;
      rear : DInt;
      n : DInt;
      d : DInt;
      t : DInt;
   END_VAR

   VAR CONSTANT 
      METHOD_01_INIT : Int := 1;   // Queue: 1 - Initialized
      METHOD_10_ENQUEUE : Int := 10;   // Queue: 10 - Enqueue data at the end position
      METHOD_11_DEQUEUE : Int := 11;   // Queue: 11 - Dequeue data from the first position
      METHOD_12_PEEK : Int := 12;   // Queue: 12 - Peek data from the first position

      STATUS_0000_DONE : Int := 16#0000;   // Queue: 0x0000 - Done
      STATUS_8002_DATA_IS_NOT_ARRAY : Int := 16#8002;   // Queue: 0x8002 - Error - Data array is not array
      STATUS_8003_DATA_IS_NOT_VALID_ARRAY : Int := 16#8003;   // Queue: 0x8003 - Error - Data array is not valid array
      STATUS_8005_DATA_ARRAY_LESS_THAN_TWO : Int := 16#8005;   // Queue: 0x8005 - Error - Data array is less than two elements
      STATUS_8010_IS_EMPTY : Int := 16#8010;   // Queue: 0x8010 - Error - Queue is empty
      STATUS_8011_IS_FULL : Int := 16#8011;   // Queue: 0x8011 - Error - Queue is full
      STATUS_8020_ERROR_MOVE_BUFFER_TO_DATA : Int := 16#8020;   // Queue: 0x8020 - Error - Movement from buffer to data
      STATUS_8021_ERROR_MOVE_DATA_TO_BUFFER : Int := 16#8021;   // Queue: 0x8021 - Error - Movement from data to buffer
      STATUS_8FFF_UNKNOWN_METHOD : Int := 16#8FFF;   // Queue: 0x8FFF - Error - Unknown method
   END_VAR


BEGIN
(*--
# Documentation

## Log

| version | date | author | description |
|:-------:|:----:|:------:|:------------|
| v3.0 | 2025-12-26 | cyanezf | Refactor, not complatible with prev. versions |
| v2.1 | 2024-12-17 | cyanezf | Full refactor and bugs fixed |

## Description

This function is used to queue/dequeue data

## Methods

In any call if queue is not initialized, the function tries to do it.
| Method | Description |
|:-------:|:------------|
| 1 | Initialize queue attributes, that means, function clears queue. |
| 10 | Add dato to last position |
| 11 | Remove data from first position |
| 12 | Peek data from first position |
| Unknown | Init. is tried and returns an error code. |

## RLO and Return

| RLO | Return | Description |
|:---:|:------:|:------------|
| TRUE | 0 | Done |
| FALSE | 0x8002 | Error - Data array is not array |
| FALSE | 0x8003 | Error - Data array is not valid array |
| FALSE | 0x8005 | Error - Data array is less than two elements |
| FALSE | 0x8010 | Error - ADT is empty |
| FALSE | 0x8011 | Error - ADT is full |
| FALSE | 0x8020 | Error - Movement from buffer to data |
| FALSE | 0x8021 | Error - Movement from data to buffer |
| FALSE | 0x8FFF | Error - Unknown method |

--*)
	 
	 REGION Method 01: Initialize
	   // 1. Initialize
	   IF NOT #instance.isInitialized OR #method = #METHOD_01_INIT THEN
	     
	     // 1.1. Initialize class attributes
	     #instance.front := 0;
	     #instance.length := 0;
	     #instance.total := 0;
	     #instance.isEmpty := 1;
	     #instance.isFull := 0;
	     
	     // 1.2. Return if data is not array
	     IF NOT IS_ARRAY(#data) THEN
	       #_queue := #STATUS_8002_DATA_IS_NOT_ARRAY;
	       ENO := FALSE;
	       RETURN;
	     END_IF;
	     
	     // 1.3. Get array length
	     #length := UDINT_TO_DINT(CountOfElements(#data));
	     
	     // 1.4. Return if array is less than two elements
	     IF #length < 2 THEN
	       #_queue := #STATUS_8005_DATA_ARRAY_LESS_THAN_TWO;
	       ENO := FALSE;
	       RETURN;
	     END_IF;
	     
	     // 1.5. Check array limits
	     #retVal := MOVE_BLK_VARIANT(SRC := #data,
	                                 COUNT := 1,
	                                 SRC_INDEX := 0,
	                                 DEST_INDEX := #length - 1,
	                                 DEST => #data);
	     // 1.6. Return is array is not ok
	     IF #retVal <> 0 THEN
	       #_queue := #STATUS_8003_DATA_IS_NOT_VALID_ARRAY;
	       ENO := FALSE;
	       RETURN;
	     END_IF;
	     
	     // 1.7. Set initialized
	     #instance.isInitialized := TRUE;
	     #instance.total := #length;
	     
	     // 1.8. Return done if method was called
	     IF #method = #METHOD_01_INIT THEN
	       #_queue := #STATUS_0000_DONE;
	       ENO := TRUE;
	       RETURN;
	     END_IF;
	   END_IF;
	 END_REGION
	 
	 CASE #method OF
	   #METHOD_10_ENQUEUE:
	     // ##################################################
	     REGION Method 10: Add to queue
	       
	       // 1. Return is queue is full
	       IF #instance.isFull THEN
	         #_queue := #STATUS_8011_IS_FULL;
	         ENO := FALSE;
	         RETURN;
	       END_IF;
	       
	       // 2. Calculate rear index
	       #rear := (#instance.front + #instance.length) MOD #instance.total;
	       
	       // 3. Move from buffer to data
	       #retVal := MOVE_BLK_VARIANT(SRC := #buffer,
	                                   COUNT := 1,
	                                   SRC_INDEX := 0,
	                                   DEST_INDEX := #rear,
	                                   DEST => #data);
	       
	       // 4. Return if data movement error
	       IF #retVal <> 0 THEN
	         #_queue := #STATUS_8020_ERROR_MOVE_BUFFER_TO_DATA;
	         ENO := FALSE;
	         RETURN;
	       END_IF;
	       
	       // 5. Update class attributes
	       IF #instance.length < #instance.total THEN
	         #instance.length += 1;
	       END_IF;
	       
	       #instance.isEmpty := #instance.length <= 0;
	       #instance.isFull := #instance.length >= #instance.total;
	       
	       // 6. Return true
	       #_queue := #STATUS_0000_DONE;
	       ENO := true;
	       RETURN;
	     END_REGION ;
	     
	   #METHOD_11_DEQUEUE:
	     // ##################################################
	     REGION Method 11: Remove from queue
	       
	       // 1. Return is queue is empty
	       IF #instance.isEmpty THEN
	         #_queue := #STATUS_8010_IS_EMPTY;
	         ENO := FALSE;
	         RETURN;
	       END_IF;
	       
	       // 2. Move from data to buffer
	       #retVal := MOVE_BLK_VARIANT(SRC := #data,
	                                   COUNT := 1,
	                                   SRC_INDEX := #instance.front,
	                                   DEST_INDEX := 0,
	                                   DEST => #buffer);
	       
	       // 3. Return if data movement error
	       IF #retVal <> 0 THEN
	         #_queue := #STATUS_8021_ERROR_MOVE_DATA_TO_BUFFER;
	         ENO := FALSE;
	         RETURN;
	       END_IF;
	       
	       // 4. Update class attributes
	       #instance.front := (#instance.front + 1) MOD #instance.total;
	       
	       IF #instance.length > 0 THEN
	         #instance.length -= 1;
	       END_IF;
	       
	       #instance.isEmpty := #instance.length <= 0;
	       #instance.isFull := #instance.length >= #instance.total;
	       
	       // 5. Return true
	       #_queue := #STATUS_0000_DONE;
	       ENO := true;
	       RETURN;
	     END_REGION ;
	     
	   #METHOD_12_PEEK:
	     // ##################################################
	     REGION Method 12: Peek first position
	       
	       // 1. Return is queue is empty
	       IF #instance.isEmpty THEN
	         #_queue := #STATUS_8010_IS_EMPTY;
	         ENO := FALSE;
	         RETURN;
	       END_IF;
	       
	       // 2. Move from data to buffer
	       #retVal := MOVE_BLK_VARIANT(SRC := #data,
	                                   COUNT := 1,
	                                   SRC_INDEX := #instance.front,
	                                   DEST_INDEX := 0,
	                                   DEST => #buffer);
	       
	       // 3. Return if data movement error
	       IF #retVal <> 0 THEN
	         #_queue := #STATUS_8021_ERROR_MOVE_DATA_TO_BUFFER;
	         ENO := FALSE;
	         RETURN;
	       END_IF;
	       
	       // 4. Return true
	       #_queue := #STATUS_0000_DONE;
	       ENO := true;
	       RETURN;
	     END_REGION ;
	     
	 END_CASE;
	 
	 // Return
	 #_queue := #STATUS_8FFF_UNKNOWN_METHOD;
	 ENO := FALSE;
	 
END_FUNCTION

